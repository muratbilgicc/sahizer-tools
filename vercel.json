{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sinif-netleri", "destination": "/sinif-netleri.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "rewrites": [
    { "source": "/sinif-netleri", "destination": "/sinif-netleri.html" }
  ],
  "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ]
}
